"""
PATTERN LENS v0.1 — Проверка ограничений (FINAL)
Разделение search_eligibility и application_authorization
"""

from typing import List, Dict, Optional, Any, Tuple
from .models import (
    ConstraintRecord, ConstraintVerdict, ConstraintSeverity,
    ConstraintCheckResult, SearchEligibility, ApplicationAuthorization,
    ParsedQuery
)


class ConstraintPolicy:
    """
    Конфигурируемая политика для неизвестных ограничений.
    
    ВАЖНО: safety_unknown_action влияет ТОЛЬКО на search_eligibility,
    но НИКОГДА не меняет application_authorization.
    """
    def __init__(self,
                 safety_unknown_search: str = "ELIGIBLE_FOR_REVIEW",
                 functional_unknown_search: str = "ELIGIBLE_FOR_REVIEW",
                 informational_unknown_search: str = "ELIGIBLE"):
        self.safety_unknown_search = safety_unknown_search
        self.functional_unknown_search = functional_unknown_search
        self.informational_unknown_search = informational_unknown_search

    def get_unknown_search_action(self, severity: ConstraintSeverity) -> str:
        if severity == ConstraintSeverity.SAFETY:
            return self.safety_unknown_search
        elif severity == ConstraintSeverity.FUNCTIONAL:
            return self.functional_unknown_search
        else:
            return self.informational_unknown_search


def check_constraint(
    constraint: ConstraintRecord,
    query: ParsedQuery
) -> ConstraintCheckResult:
    """
    Проверяет одно ограничение против запроса.
    
    Семантика:
    - SATISFIED: значение явно присутствует и удовлетворяет оператору
    - VIOLATED: значение явно присутствует и НЕ удовлетворяет оператору
    - UNKNOWN: значение отсутствует или тип несовместим
    - NOT_APPLICABLE: ограничение не относится к данному контексту
    """
    # Если в запросе нет требования по этому subject
    if constraint.subject not in query.requested_constraints:
        # SAFETY всегда UNKNOWN (не NOT_APPLICABLE)
        if constraint.severity == ConstraintSeverity.SAFETY:
            return ConstraintCheckResult(
                constraint_id=constraint.constraint_id,
                subject=constraint.subject,
                severity=constraint.severity,
                verdict=ConstraintVerdict.UNKNOWN,
                explanation=f"SAFETY constraint '{constraint.subject}' not specified in query"
            )
        return ConstraintCheckResult(
            constraint_id=constraint.constraint_id,
            subject=constraint.subject,
            severity=constraint.severity,
            verdict=ConstraintVerdict.NOT_APPLICABLE,
            explanation=f"Constraint '{constraint.subject}' not relevant to query"
        )

    query_value = query.requested_constraints[constraint.subject]

    # Проверка на совместимость типов
    verdict, flags = _apply_operator(constraint.operator, constraint.value, query_value)

    explanation = f"'{constraint.subject}' {constraint.operator} {constraint.value} (query: {query_value}) → {verdict.value}"

    return ConstraintCheckResult(
        constraint_id=constraint.constraint_id,
        subject=constraint.subject,
        severity=constraint.severity,
        verdict=verdict,
        explanation=explanation,
        flags=flags
    )


def _apply_operator(operator: str, pattern_value: Any, query_value: Any) -> Tuple[ConstraintVerdict, List[str]]:
    """
    Применяет оператор сравнения.
    Возвращает (вердикт, флаги).
    """
    flags = []
    
    try:
        if operator == "eq":
            # Проверка типа
            if type(pattern_value) != type(query_value):
                if not _is_numeric_compatible(pattern_value, query_value):
                    return ConstraintVerdict.UNKNOWN, ["type_mismatch"]
            return (ConstraintVerdict.SATISFIED if pattern_value == query_value 
                    else ConstraintVerdict.VIOLATED), flags
            
        elif operator == "neq":
            if type(pattern_value) != type(query_value):
                if not _is_numeric_compatible(pattern_value, query_value):
                    return ConstraintVerdict.UNKNOWN, ["type_mismatch"]
            return (ConstraintVerdict.SATISFIED if pattern_value != query_value 
                    else ConstraintVerdict.VIOLATED), flags
            
        elif operator == "gte":
            if not _is_numeric_compatible(pattern_value, query_value):
                return ConstraintVerdict.UNKNOWN, ["type_mismatch"]
            return (ConstraintVerdict.SATISFIED if query_value >= pattern_value 
                    else ConstraintVerdict.VIOLATED), flags
            
        elif operator == "lte":
            if not _is_numeric_compatible(pattern_value, query_value):
                return ConstraintVerdict.UNKNOWN, ["type_mismatch"]
            return (ConstraintVerdict.SATISFIED if query_value <= pattern_value 
                    else ConstraintVerdict.VIOLATED), flags
            
        elif operator == "in":
            if not isinstance(pattern_value, (list, tuple, set)):
                return ConstraintVerdict.UNKNOWN, ["invalid_pattern_value"]
            return (ConstraintVerdict.SATISFIED if query_value in pattern_value 
                    else ConstraintVerdict.VIOLATED), flags
            
        elif operator == "contains":
            if not isinstance(query_value, (list, tuple, set, str)):
                return ConstraintVerdict.UNKNOWN, ["invalid_query_value"]
            return (ConstraintVerdict.SATISFIED if pattern_value in query_value 
                    else ConstraintVerdict.VIOLATED), flags
            
        elif operator == "requires":
            # pattern требует наличия query_value (не None)
            return (ConstraintVerdict.SATISFIED if query_value is not None 
                    else ConstraintVerdict.VIOLATED), flags
            
        else:
            return ConstraintVerdict.UNKNOWN, ["unsupported_operator"]
            
    except (TypeError, ValueError):
        return ConstraintVerdict.UNKNOWN, ["type_mismatch"]


def _is_numeric_compatible(a: Any, b: Any) -> bool:
    """Проверяет, можно ли сравнивать как числа"""
    try:
        float(a)
        float(b)
        return True
    except (TypeError, ValueError):
        return False


def compute_eligibility_and_authorization(
    constraint_results: List[ConstraintCheckResult],
    policy: ConstraintPolicy,
    critical_evidence_failed: int = 0
) -> Tuple[SearchEligibility, ApplicationAuthorization]:
    """
    Вычисляет ДВА независимых статуса:
    - search_eligibility: можно ли показывать
    - application_authorization: разрешено ли применять
    
    Возвращает (SearchEligibility, ApplicationAuthorization).
    """
    has_violated = False
    has_unknown_safety = False
    has_unknown_other = False
    
    for cr in constraint_results:
        if cr.verdict == ConstraintVerdict.VIOLATED:
            has_violated = True
        elif cr.verdict == ConstraintVerdict.UNKNOWN:
            if cr.severity == ConstraintSeverity.SAFETY:
                has_unknown_safety = True
            else:
                has_unknown_other = True
    
    # ============ SEARCH ELIGIBILITY ============
    # Нарушение hard constraint → EXCLUDED
    if has_violated:
        search_elig = SearchEligibility.EXCLUDED
    elif has_unknown_safety:
        # SAFETY UNKNOWN → можно показать с флагом
        search_elig = SearchEligibility.ELIGIBLE_FOR_REVIEW
    elif has_unknown_other:
        search_elig = SearchEligibility.ELIGIBLE_FOR_REVIEW
    else:
        search_elig = SearchEligibility.ELIGIBLE
    
    # ============ APPLICATION AUTHORIZATION ============
    # КРИТИЧЕСКОЕ ПРАВИЛО: SAFETY UNKNOWN → DENIED (всегда)
    if has_violated:
        app_auth = ApplicationAuthorization.DENIED
    elif has_unknown_safety:
        # SAFETY UNKNOWN ВСЕГДА DENIED (независимо от политики)
        app_auth = ApplicationAuthorization.DENIED
    elif critical_evidence_failed:
        # Критический тест провален → DENIED
        app_auth = ApplicationAuthorization.DENIED
    elif has_unknown_other:
        app_auth = ApplicationAuthorization.CONDITIONAL
    else:
        app_auth = ApplicationAuthorization.AUTHORIZED
    
    return search_elig, app_auth
