"""
PATTERN LENS v0.1 — Детерминированное ранжирование (FINAL)
"""

from typing import List, Dict, Optional
from .models import (
    Candidate, RankedCandidate, SearchEligibility,
    ApplicationAuthorization, EvidenceRecord, ConstraintVerdict
)


# Приоритет search_eligibility (меньше = лучше)
SEARCH_ELIGIBILITY_RANK = {
    SearchEligibility.ELIGIBLE: 0,
    SearchEligibility.ELIGIBLE_FOR_REVIEW: 1,
    SearchEligibility.EXCLUDED: 2,
}


def rank_candidates(
    candidates: List[Candidate],
    evidence_map: Dict[str, EvidenceRecord] = None
) -> List[RankedCandidate]:
    """
    Детерминированное лексикографическое ранжирование.
    
    Ключ сортировки:
    (search_eligibility_rank, -critical_evidence_failed, match_tier,
     -passed_evidence_count, unknown_constraints_count, pattern_id)
    
    Финальный критерий pattern_id гарантирует детерминизм.
    """
    evidence_map = evidence_map or {}
    
    def sort_key(c: Candidate):
        return (
            SEARCH_ELIGIBILITY_RANK[c.search_eligibility],
            -c.critical_evidence_failed,       # критический провал → выше (хуже)
            c.match_tier,                       # 0=ID, 1=INTENT, 2=TAG, 3=DESC
            -c.passed_evidence_count,           # больше PASSED → выше
            c.unknown_constraints_count,        # меньше UNKNOWN → выше
            c.pattern.pattern_id                # ФИНАЛЬНЫЙ детерминированный критерий
        )
    
    sorted_candidates = sorted(candidates, key=sort_key)
    
    ranked = []
    for rank, c in enumerate(sorted_candidates, 1):
        linked_evidence = _resolve_evidence(c.pattern.evidence_refs, evidence_map)
        unresolved = _collect_unresolved(c, linked_evidence)
        reasons = _build_match_reasons(c, linked_evidence)
        
        ranked.append(RankedCandidate(
            pattern_id=c.pattern.pattern_id,
            name=c.pattern.name,
            rank=rank,
            match_type=c.match_type,
            match_tier=c.match_tier,
            matched_tokens=c.matched_tokens,
            search_eligibility=c.search_eligibility,
            application_authorization=c.application_authorization,
            passed_evidence_count=c.passed_evidence_count,
            failed_evidence_count=c.failed_evidence_count,
            critical_evidence_failed=c.critical_evidence_failed,
            unknown_constraints_count=c.unknown_constraints_count,
            constraint_results=c.constraint_results,
            linked_evidence=linked_evidence,
            unresolved_questions=unresolved,
            match_reasons=reasons
        ))
    
    return ranked


def _resolve_evidence(refs: List[str], evidence_map: Dict) -> List[EvidenceRecord]:
    """Разрешает ссылки на свидетельства (с дедупликацией)"""
    seen = set()
    result = []
    for r in refs:
        if r in evidence_map and r not in seen:
            result.append(evidence_map[r])
            seen.add(r)
    return result


def _collect_unresolved(c: Candidate, evidence: List[EvidenceRecord]) -> List[str]:
    """Собирает нерешённые вопросы"""
    unresolved = []
    
    for cr in c.constraint_results:
        if cr.verdict == ConstraintVerdict.UNKNOWN:
            unresolved.append(f"Ограничение '{cr.subject}': статус неизвестен")
        elif cr.verdict == ConstraintVerdict.VIOLATED:
            unresolved.append(f"Ограничение '{cr.subject}': НАРУШЕНО")
    
    for ev in evidence:
        if ev.result == "NOT_EXECUTED":
            unresolved.append(f"Свидетельство '{ev.evidence_id}': тест не выполнен")
        elif ev.result == "INCONCLUSIVE":
            unresolved.append(f"Свидетельство '{ev.evidence_id}': результат неопределён")
    
    if c.critical_evidence_failed:
        unresolved.append("КРИТИЧЕСКОЕ свидетельство провалено — применение запрещено")
    
    return unresolved


def _build_match_reasons(c: Candidate, evidence: List[EvidenceRecord]) -> List[str]:
    """Формирует объяснение"""
    reasons = []
    
    reasons.append(f"Совпадение: {c.match_type} (tier {c.match_tier}, токены: {c.matched_tokens})")
    reasons.append(f"Search eligibility: {c.search_eligibility.value}")
    reasons.append(f"Application authorization: {c.application_authorization.value}")
    
    for cr in c.constraint_results:
        if cr.verdict == ConstraintVerdict.SATISFIED:
            reasons.append(f"✅ Ограничение '{cr.subject}': удовлетворено")
        elif cr.verdict == ConstraintVerdict.VIOLATED:
            reasons.append(f"❌ Ограничение '{cr.subject}': НАРУШЕНО")
        elif cr.verdict == ConstraintVerdict.UNKNOWN:
            reasons.append(f"⚠️ Ограничение '{cr.subject}': статус неизвестен")
    
    for ev in evidence:
        if ev.result == "PASSED":
            reasons.append(f"✅ Свидетельство '{ev.evidence_id}': PASSED")
        elif ev.result == "FAILED":
            reasons.append(f"❌ Свидетельство '{ev.evidence_id}': FAILED (severity: {ev.severity.value})")
        elif ev.result == "NOT_EXECUTED":
            reasons.append(f"⚠️ Свидетельство '{ev.evidence_id}': не выполнено")
    
    return reasons


def count_evidence(evidence: List[EvidenceRecord]) -> tuple:
    """
    Подсчитывает свидетельства.
    Возвращает (passed, failed, critical_failed).
    """
    passed = 0
    failed = 0
    critical_failed = 0
    
    for ev in evidence:
        if ev.result == "PASSED":
            passed += 1
        elif ev.result == "FAILED":
            failed += 1
            if ev.severity == "CRITICAL":
                critical_failed = 1
    
    return passed, failed, critical_failed


def count_unknowns(constraint_results: List) -> int:
    """Подсчёт UNKNOWN"""
    return sum(1 for cr in constraint_results if cr.verdict == ConstraintVerdict.UNKNOWN)
