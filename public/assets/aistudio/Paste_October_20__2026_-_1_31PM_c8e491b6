"""

import re
from collections import defaultdict
from typing import List, Dict, Set
from .models import PatternRecord, ParsedQuery, Candidate


# Стоп-слова
STOP_WORDS = {
    "и", "в", "на", "с", "по", "для", "из", "к", "о", "об", "от", "до",
    "the", "a", "an", "of", "in", "on", "with", "for", "from", "to",
    "is", "are", "was", "were", "be", "been"
}


def simple_stem(word: str) -> str:
    """Простой суффиксный стеммер (без внешних зависимостей)"""
    word = word.lower()
    suffixes = ["ing", "ed", "es", "s", "ый", "ая", "ое", "ые", "ого",
                "ами", "ями", "ов", "ев", "ий", "ия", "ию", "ии"]
    for suf in sorted(suffixes, key=len, reverse=True):
        if word.endswith(suf) and len(word) > len(suf) + 2:
            return word[:-len(suf)]
    return word


def tokenize(text: str) -> List[str]:
    """Токенизация + стемминг + фильтрация стоп-слов"""
    raw_tokens = re.findall(r'\b[a-zA-Zа-яА-Я0-9_-]+\b', text.lower())
    return [simple_stem(t) for t in raw_tokens if len(t) > 1 and t not in STOP_WORDS]


class InvertedIndex:
    """Инвертированный индекс"""
    
    def __init__(self, patterns: List[PatternRecord]):
        self.patterns = {p.pattern_id: p for p in patterns}
        self.by_id: Dict[str, str] = {}
        self.by_intent_token: Dict[str, Set[str]] = defaultdict(set)
        self.by_tag: Dict[str, Set[str]] = defaultdict(set)
        self.by_description_token: Dict[str, Set[str]] = defaultdict(set)
        self._build()
    
    def _build(self):
        for p in self.patterns.values():
            self.by_id[p.pattern_id] = p.pattern_id
            for token in tokenize(p.intent):
                self.by_intent_token[token].add(p.pattern_id)
            for tag in p.tags:
                self.by_tag[tag.lower()].add(p.pattern_id)
            for token in tokenize(p.description):
                self.by_description_token[token].add(p.pattern_id)
    
    def get_version(self) -> str:
        return f"v1-{len(self.patterns)}"


def retrieve_candidates(query: ParsedQuery, index: InvertedIndex) -> List[Candidate]:
    """
    Поиск кандидатов с накоплением ВСЕХ совпавших токенов.
    """
    candidates_by_id: Dict[str, Candidate] = {}
    
    def add_candidate(pid: str, match_type: str, tier: int, token: str):
        if pid not in candidates_by_id:
            candidates_by_id[pid] = Candidate(
                pattern=index.patterns[pid],
                match_type=match_type,
                match_tier=tier,
                matched_tokens=[token]
            )
        else:
            c = candidates_by_id[pid]
            if token not in c.matched_tokens:
                c.matched_tokens.append(token)
            if tier < c.match_tier:
                c.match_tier = tier
                c.match_type = match_type
    
    # Tier 0: точное ID
    for pid in query.explicit_ids:
        if pid in index.by_id:
            add_candidate(pid, "EXACT_ID", 0, pid)
    
    # Tier 1: intent
    for token in query.intent_tokens:
        for pid in index.by_intent_token.get(token, set()):
            add_candidate(pid, "INTENT", 1, token)
    
    # Tier 2: теги
    for tag in query.tags:
        for pid in index.by_tag.get(tag.lower(), set()):
            add_candidate(pid, "TAG", 2, tag)
    
    # Tier 3: описание
    for token in query.tokens:
        for pid in index.by_description_token.get(token, set()):
            add_candidate(pid, "DESCRIPTION", 3, token)
    
    return list(candidates_by_id.values())
