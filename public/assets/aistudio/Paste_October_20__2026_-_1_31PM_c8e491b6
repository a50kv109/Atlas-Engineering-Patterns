def make_pattern(pid="pat-001", constraints=None, evidence_refs=None, tags=None):
    return PatternRecord(
        pattern_id=pid,
        name=f"Pattern {pid}",
        intent="test intent",
        description="test description",
        domain="test",
        constraints=constraints or [],
        evidence_refs=evidence_refs or [],
        tags=tags or []
    )


def make_evidence(eid="evid-001", result=EvidenceResult.PASSED, severity=EvidenceSeverity.MAJOR):
    return EvidenceRecord(
        evidence_id=eid,
        claim_id="claim-001",
        claim="test claim",
        method="AUTOMATED_UNIT_TEST",
        object_version="1.0",
        result=result,
        severity=severity
    )


