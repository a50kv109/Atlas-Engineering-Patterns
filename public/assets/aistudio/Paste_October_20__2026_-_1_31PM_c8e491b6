```python
"""
PATTERN LENS v0.1 — Главный движок (FINAL)
"""

import time
from typing import List, Dict, Optional, Any
from .models import (
    PatternRecord, EvidenceRecord, ParsedQuery, SearchResult,
    Candidate, SearchEligibility, ApplicationAuthorization
)
from .retrieval import InvertedIndex, retrieve_candidates, tokenize
from .constraints import (
    ConstraintPolicy, check_constraint,
    compute_eligibility_and_authorization
)
from .ranking import rank_candidates, count_evidence, count_unknowns


class SearchEngine:
    """Главный движок PATTERN LENS."""
    
    def __init__(self,
                 patterns: List[PatternRecord],
                 evidence: List[EvidenceRecord] = None,
                 policy: ConstraintPolicy = None):
        self.patterns = patterns
        self.evidence_map = {e.evidence_id: e for e in (evidence or [])}
        self.index = InvertedIndex(patterns)
        self.policy = policy or ConstraintPolicy()
        self._cache: Dict[str, Any] = {}
        self._telemetry = {
            "requests": 0, "cache_hits": 0, "cache_misses": 0, "empty_results": 0
        }
        
        # Валидация дубликатов
        seen_ids = set()
        for p in patterns:
            if p.pattern_id in seen_ids:
                raise ValueError(f"Duplicate pattern_id: {p.pattern_id}")
            seen_ids.add(p.pattern_id)
    
    def search(
        self,
        raw_query: str,
        requested_constraints: Dict[str, Any] = None,
        use_cache: bool = True
    ) -> SearchResult:
        start_time = time.time()
        self._telemetry["requests"] += 1
        
        query = self._parse_query(raw_query, requested_constraints or {})
        
        if not query.tokens and not query.explicit_ids:
            return SearchResult(
                query_raw=raw_query,
                search_status="INSUFFICIENT_DATA",
                candidates=[],
                excluded_candidates=[],
                limitations=["Пустой запрос"],
                telemetry={"duration_ms": 0}
            )
        
        cache_key = self._cache_key(query)
        if use_cache and cache_key in self._cache:
            self._telemetry["cache_hits"] += 1
            return self._cache[cache_key]
        
        self._telemetry["cache_misses"] += 1
        
        candidates = retrieve_candidates(query, self.index)
        
        if not candidates:
            self._telemetry["empty_results"] += 1
            result = SearchResult(
                query_raw=raw_query,
                search_status="NO_MATCH",
                candidates=[],
                excluded_candidates=[],
                limitations=["Нет кандидатов по запросу"],
                telemetry={"duration_ms": round((time.time() - start_time) * 1000, 2)}
            )
            if use_cache:
                self._cache[cache_key] = result
            return result
        
        # Проверка ограничений + свидетельств
        for c in candidates:
            c.constraint_results = [
                check_constraint(cons, query)
                for cons in c.pattern.constraints
            ]
            
            linked_evidence = [self.evidence_map[r] for r in c.pattern.evidence_refs 
                              if r in self.evidence_map]
            passed, failed, critical_failed = count_evidence(linked_evidence)
            c.passed_evidence_count = passed
            c.failed_evidence_count = failed
            c.critical_evidence_failed = critical_failed
            c.unknown_constraints_count = count_unknowns(c.constraint_results)
            
            # Вычисление ДВУХ статусов
            c.search_eligibility, c.application_authorization = \
                compute_eligibility_and_authorization(
                    c.constraint_results, self.policy, critical_failed
                )
        
        # Разделение
        included = [c for c in candidates if c.search_eligibility != SearchEligibility.EXCLUDED]
        excluded = [c for c in candidates if c.search_eligibility == SearchEligibility.EXCLUDED]
        
        # Ранжирование
        ranked = rank_candidates(included, self.evidence_map)
        
        # Формирование excluded
        excluded_list = [
            {
                "pattern_id": c.pattern.pattern_id,
                "name": c.pattern.name,
                "reason": "EXCLUDED_BY_CONSTRAINT",
                "constraint_results": [
                    {"subject": cr.subject, "verdict": cr.verdict.value, "explanation": cr.explanation}
                    for cr in c.constraint_results
                ]
            }
            for c in excluded
        ]
        
        # Определение статуса
        if ranked:
            if any(r.search_eligibility == SearchEligibility.ELIGIBLE for r in ranked):
                status = "MATCH_FOUND"
            else:
                status = "PARTIAL_MATCH"
        else:
            status = "NO_MATCH"
        
        # Ограничения результата
        limitations = []
        if any(r.search_eligibility == SearchEligibility.ELIGIBLE_FOR_REVIEW for r in ranked):
            limitations.append("Есть кандидаты, требующие проверки")
        if any(r.application_authorization == ApplicationAuthorization.DENIED for r in ranked):
            limitations.append("Есть кандидаты с запретом на применение")
        if excluded_list:
            limitations.append(f"{len(excluded_list)} кандидатов исключено по ограничениям")
        
        result = SearchResult(
            query_raw=raw_query,
            search_status=status,
            candidates=ranked,
            excluded_candidates=excluded_list,
            limitations=limitations,
            telemetry={
                "duration_ms": round((time.time() - start_time) * 1000, 2),
                "candidates_found": len(candidates),
                "included": len(included),
                "excluded": len(excluded)
            }
        )
        
        if use_cache:
            self._cache[cache_key] = result
        
        return result
    
    def _parse_query(self, raw: str, requested_constraints: Dict[str, Any]) -> ParsedQuery:
        tokens = tokenize(raw)
        explicit_ids = [t for t in raw.split() if t.startswith(("pat-", "impl-", "evid-"))]
        tags = [t for t in tokens if t.startswith("#")]
        intent_tokens = [t for t in tokens if not t.startswith("#") and t not in explicit_ids]
        
        return ParsedQuery(
            raw=raw,
            normalized=raw.lower().strip(),
            tokens=tokens,
            intent_tokens=intent_tokens,
            tags=tags,
            explicit_ids=explicit_ids,
            requested_constraints=requested_constraints
        )
    
    def _cache_key(self, query: ParsedQuery) -> str:
        constraints_hash = hash(str(sorted(query.requested_constraints.items())))
        return f"{query.normalized}|{self.index.get_version()}|{constraints_hash}"
    
    def get_stats(self) -> Dict[str, Any]:
        return dict(self._telemetry)
    
    def clear_cache(self):
        self._cache = {}
