"""
FIX 3: EVIDENCE VERSIONING
Все свидетельства проверяются на pattern_id и object_version.
Детерминированное правило для нескольких свидетельств с одним claim_id.
"""

from typing import List, Optional, Dict
from enum import Enum


class EvidenceResult(str, Enum):
    PASSED = "PASSED"
    FAILED = "FAILED"
    INCONCLUSIVE = "INCONCLUSIVE"
    NOT_EXECUTED = "NOT_EXECUTED"


_RESULT_PRIORITY = {
    EvidenceResult.PASSED: 0,
    EvidenceResult.FAILED: 1,
    EvidenceResult.INCONCLUSIVE: 2,
    EvidenceResult.NOT_EXECUTED: 3,
}


def filter_evidence_for_version(
    evidence_list: List,
    pattern_id: str,
    pattern_version: str
) -> List:
    """
    Оставляет только свидетельства, относящиеся к текущей версии паттерна.
    
    Правило: ev.linked_pattern_id == pattern_id AND ev.object_version == pattern_version.
    """
    return [
        ev for ev in evidence_list
        if ev.linked_pattern_id == pattern_id
        and ev.object_version == pattern_version
    ]


def select_canonical_evidence(evidence_list: List) -> Optional[object]:
    """
    Детерминированный выбор одного свидетельства из нескольких
    с одинаковым claim_id.
    
    Приоритет:
    1. PASSED (наивысший)
    2. FAILED
    3. INCONCLUSIVE
    4. NOT_EXECUTED (низший)
    
    При равенстве result:
    - Более поздний timestamp
    - Более надёжный verifier (не "unknown"/"none"/"unverified")
    - Лексикографически меньший evidence_id (детерминизм)
    """
    if not evidence_list:
        return None
    
    def sort_key(ev):
        # Приоритет результата
        result_rank = _RESULT_PRIORITY.get(ev.result, 99)
        
        # Timestamp (позже = лучше; инвертируем для min)
        try:
            ts = -int(ev.timestamp or "0")
        except (ValueError, TypeError):
            ts = 0
        
        # Надёжность верификатора
        verifier = (ev.verifier or "").strip().lower()
        verifier_unreliable = verifier in {"", "unknown", "none", "unverified"}
        verifier_rank = 1 if verifier_unreliable else 0
        
        return (result_rank, verifier_rank, ts, ev.evidence_id)
    
    return min(evidence_list, key=sort_key)


def has_critical_failure(
    evidence_list: List,
    pattern_id: str,
    pattern_version: str
) -> bool:
    """
    Проверяет наличие CRITICAL + FAILED среди свидетельств ТЕКУЩЕЙ версии.
    
    ВАЖНО: старая версия НЕ блокирует новую.
    """
    current = filter_evidence_for_version(evidence_list, pattern_id, pattern_version)
    
    for ev in current:
        severity = getattr(ev, "severity", None)
        severity_value = severity.value if hasattr(severity, "value") else str(severity)
        
        if severity_value == "CRITICAL" and ev.result == EvidenceResult.FAILED:
            return True
    
    return False


def group_evidence_by_claim(evidence_list: List) -> Dict[str, List]:
    """Группировка свидетельств по claim_id"""
    result: Dict[str, List] = {}
    for ev in evidence_list:
        result.setdefault(ev.claim_id, []).append(ev)
    return result
