"""
Тесты для 5 исправлений PATTERN LENS v0.1
"""

import pytest
from fixes.requires import eval_requires
from fixes.authorization import (
    compute_authorization, ApplicationAuthorization,
    ConstraintSeverity, EvidenceSeverity, EvidenceResult, ConstraintVerdict
)
from fixes.evidence_versioning import (
    filter_evidence_for_version, select_canonical_evidence,
    has_critical_failure, group_evidence_by_claim
)
from fixes.verified_claim import check_verified_claim_for_intent
from fixes.units import eval_numeric_comparison


# ============ FIX 1: REQUIRES ============

def test_fix1_missing_key_incomplete_inventory():
    """Отсутствие ключа при неполном инвентаре → UNKNOWN"""
    verdict, flags = eval_requires("foo", {"bar": True}, inventory_is_complete=False)
    assert verdict == ConstraintVerdict.UNKNOWN
    assert "incomplete_inventory" in flags


def test_fix1_missing_key_complete_inventory():
    """Отсутствие ключа при полном инвентаре → VIOLATED"""
    verdict, flags = eval_requires("foo", {"bar": True}, inventory_is_complete=True)
    assert verdict == ConstraintVerdict.VIOLATED


def test_fix1_missing_in_collection_incomplete():
