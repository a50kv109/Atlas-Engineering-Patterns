"""
FIX 5: UNITS — согласованность обязательна
Несовместимые или противоречивые единицы → UNKNOWN (никогда VIOLATED).
"""

import math
from typing import Tuple, List, Any, Optional
from enum import Enum


class ConstraintVerdict(str, Enum):
    SATISFIED = "SATISFIED"
    VIOLATED = "VIOLATED"
    UNKNOWN = "UNKNOWN"
    NOT_APPLICABLE = "NOT_APPLICABLE"


def extract_value_and_unit(value: Any) -> Tuple[Any, Optional[str]]:
    """
    Извлекает значение и единицу.
    
    Поддерживаемые формы:
    - {"value": 16, "unit": "GB"}
    - (16, "GB")
    - [16, "GB"]
    - 16 (без единицы)
    """
    if isinstance(value, dict):
        return value.get("value"), value.get("unit")
    if isinstance(value, (list, tuple)) and len(value) == 2:
        return value[0], value[1]
    return value, None


def eval_numeric_comparison(
    operator: str,
    pattern_threshold: Any,
    query_environment: Any,
    unit_required: Optional[str] = None
) -> Tuple[ConstraintVerdict, List[str]]:
    """
    Числовое сравнение с обязательной согласованностью единиц.
    
    Правила единиц:
    1. Если unit_required задан:
       - p_unit должен быть None ИЛИ равен unit_required.
         Если p_unit задан и ≠ unit_required → UNKNOWN ["unit_conflict_pattern_vs_required"].
       - q_unit должен быть задан и равен unit_required.
         Если q_unit отсутствует → UNKNOWN ["missing_mandatory_unit"].
         Если q_unit ≠ unit_required → UNKNOWN ["unit_mismatch"].
    2. Если unit_required НЕ задан, но p_unit задан:
       - q_unit должен быть задан и равен p_unit.
         Иначе → UNKNOWN ["unit_mismatch"] или ["missing_mandatory_unit"].
    3. Если ни unit_required, ни p_unit не заданы:
       - q_unit игнорируется (сравнение без единиц).
    4. Любое несовпадение единиц → UNKNOWN (никогда VIOLATED).
    5. NaN/Inf → UNKNOWN ["non_finite_numeric_value"].
    6. bool → UNKNOWN ["boolean_cannot_be_numeric"].
    """
    # 1. Защита от bool (строгая проверка ДО int)
    if isinstance(query_environment, bool) or isinstance(pattern_threshold, bool):
        return ConstraintVerdict.UNKNOWN, ["boolean_cannot_be_numeric"]
    
    # 2. Извлечение значений и единиц
    q_val, q_unit = extract_value_and_unit(query_environment)
    p_val, p_unit = extract_value_and_unit(pattern_threshold)
    
    # 3. Нормализация единиц
    q_unit_norm = q_unit.strip().lower() if isinstance(q_unit, str) else None
    p_unit_norm = p_unit.strip().lower() if isinstance(p_unit, str) else None
    req_unit_norm = unit_required.strip().lower() if isinstance(unit_required, str) else None
    
    # 4. Проверка согласованности единиц
    if req_unit_norm is not None:
        # unit_required задан
        if p_unit_norm is not None and p_unit_norm != req_unit_norm:
            return ConstraintVerdict.UNKNOWN, [
                f"unit_conflict_pattern_vs_required: pattern='{p_unit}', required='{unit_required}'"
            ]
        if q_unit_norm is None:
            return ConstraintVerdict.UNKNOWN, [
                f"missing_mandatory_unit: expected '{unit_required}'"
            ]
        if q_unit_norm != req_unit_norm:
            return ConstraintVerdict.UNKNOWN, [
                f"unit_mismatch: got '{q_unit}', expected '{unit_required}'"
            ]
    elif p_unit_norm is not None:
        # unit_required не задан, но p_unit задан
        if q_unit_norm is None:
            return ConstraintVerdict.UNKNOWN, [
                f"missing_mandatory_unit: expected '{p_unit}'"
            ]
        if q_unit_norm != p_unit_norm:
            return ConstraintVerdict.UNKNOWN, [
                f"unit_mismatch: got '{q_unit}', expected '{p_unit}'"
            ]
    # else: ни unit_required, ни p_unit — q_unit игнорируется
    
    # 5. Проверка числовых типов
    if not isinstance(q_val, (int, float)) or not isinstance(p_val, (int, float)):
        return ConstraintVerdict.UNKNOWN, ["type_mismatch_not_a_number"]
    
    # 6. Защита от NaN/Inf
    if not math.isfinite(q_val) or not math.isfinite(p_val):
        return ConstraintVerdict.UNKNOWN, ["non_finite_numeric_value"]
    
    # 7. Сравнение
    if operator == "gte":
        return (ConstraintVerdict.SATISFIED if q_val >= p_val else ConstraintVerdict.VIOLATED), []
    elif operator == "lte":
        return (ConstraintVerdict.SATISFIED if q_val <= p_val else ConstraintVerdict.VIOLATED), []
    elif operator == "eq":
        return (ConstraintVerdict.SATISFIED if q_val == p_val else ConstraintVerdict.VIOLATED), []
    elif operator == "neq":
        return (ConstraintVerdict.SATISFIED if q_val != p_val else ConstraintVerdict.VIOLATED), []
    else:
        return ConstraintVerdict.UNKNOWN, [f"unsupported_numeric_operator: '{operator}'"]
