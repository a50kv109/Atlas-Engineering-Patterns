"""
FIX 1: REQUIRES — отсутствие ≠ нарушение
Отсутствие ресурса трактуется как VIOLATED только при явно
подтверждённой полноте инвентаря (inventory_is_complete=True).
"""

from typing import Tuple, List, Any, Set
from enum import Enum


class ConstraintVerdict(str, Enum):
    SATISFIED = "SATISFIED"
    VIOLATED = "VIOLATED"
    UNKNOWN = "UNKNOWN"
    NOT_APPLICABLE = "NOT_APPLICABLE"


# Нормализованные статусы
_POSITIVE_STATUSES: Set[str] = {
    "enabled", "available", "present", "active", "true", "on", "yes", "1"
}
_NEGATIVE_STATUSES: Set[str] = {
    "disabled", "unavailable", "absent", "inactive", "false", "off", "no", "0"
}


def eval_requires(
    pattern_requirement: Any,
    query_environment: Any,
    inventory_is_complete: bool = False
) -> Tuple[ConstraintVerdict, List[str]]:
    """
    Формальная семантика оператора 'requires'.
    
    ВАЖНО: отсутствие ресурса в коллекции/словаре → VIOLATED
    ТОЛЬКО при inventory_is_complete=True.
    Иначе → UNKNOWN (неполные сведения).
    
    Args:
        pattern_requirement: требуемый ресурс/флаг
        query_environment: окружение запроса (bool, str, число, коллекция, словарь)
        inventory_is_complete: True, если окружение — полный инвентарь
    
    Returns:
        (вердикт, список флагов)
    """
    # 1. None → UNKNOWN
    if query_environment is None:
        return ConstraintVerdict.UNKNOWN, ["missing_requirement_data"]
    
    # 2. bool (строгая проверка ДО int, т.к. isinstance(False, int) == True)
    if isinstance(query_environment, bool):
        if query_environment is True:
            return ConstraintVerdict.SATISFIED, []
        else:
            return ConstraintVerdict.VIOLATED, []
    
    # 3. Числа (int, float) — НЕ логические флаги
    if isinstance(query_environment, (int, float)):
        return ConstraintVerdict.UNKNOWN, ["numeric_value_not_a_flag"]
    
    # 4. Строки
    if isinstance(query_environment, str):
        normalized = query_environment.strip().lower()
        if normalized in _POSITIVE_STATUSES:
            return ConstraintVerdict.SATISFIED, []
        elif normalized in _NEGATIVE_STATUSES:
            return ConstraintVerdict.VIOLATED, []
        else:
            return ConstraintVerdict.UNKNOWN, [f"unrecognized_status_string: '{query_environment}'"]
    
    # 5. Коллекции (list, set, tuple)
    if isinstance(query_environment, (list, set, tuple)):
        req_key = str(pattern_requirement).strip().lower()
        normalized_collection = {str(item).strip().lower() for item in query_environment}
        
        if req_key in normalized_collection:
            return ConstraintVerdict.SATISFIED, []
        
        # Элемента нет — VIOLATED только при полном инвентаре
        if inventory_is_complete:
            return ConstraintVerdict.VIOLATED, [
                f"required_capability_absent: '{pattern_requirement}'"
            ]
        else:
            return ConstraintVerdict.UNKNOWN, ["incomplete_inventory"]
    
    # 6. Словарь
    if isinstance(query_environment, dict):
        if pattern_requirement not in query_environment:
            if inventory_is_complete:
                return ConstraintVerdict.VIOLATED, [
                    f"required_key_absent: '{pattern_requirement}'"
                ]
            else:
                return ConstraintVerdict.UNKNOWN, ["incomplete_inventory"]
        
        sub_val = query_environment[pattern_requirement]
        # Рекурсивная проверка значения (inventory полный для вложенного)
        return eval_requires(True, sub_val, inventory_is_complete=True)
    
    # 7. Иное
    return ConstraintVerdict.UNKNOWN, ["unsupported_environment_type"]
