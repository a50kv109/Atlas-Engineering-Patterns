"""
FIX 4: VERIFIED CLAIM — только явная связка
Автоподстановка mandatory_claim_ids запрещена.
"""

from typing import List, Set


VALID_VERIFICATION_METHODS: Set[str] = {
    "AUTOMATED_UNIT_TEST",
    "EMPIRICAL_STUDY",
    "FORMAL_PROOF",
    "HARDWARE_BENCH_TEST",
}

_UNRELIABLE_VERIFIERS: Set[str] = {"", "unknown", "none", "unverified"}


def check_verified_claim_for_intent(
    pattern,  # PatternRecord
    target_claim_ids: Set[str],
    evidence_records: List
) -> bool:
    """
    Возвращает True ТОЛЬКО при явной связке claim_id с намерением.
    
    Правила:
    1. target_claim_ids НЕ пуст (явно задан запросом).
    2. ev.claim_id ∈ target_claim_ids.
    3. ev.linked_pattern_id == pattern.pattern_id.
    4. ev.object_version == pattern.version.
    5. ev.result == PASSED.
    6. ev.method ∈ VALID_VERIFICATION_METHODS.
    7. ev.verifier не пуст и не в {"unknown", "none", "unverified"}.
    
    Если target_claim_ids пуст → False (нет явной связки).
    mandatory_claim_ids НЕ подставляются автоматически.
    """
    # 1. Явная связка обязательна
    if not target_claim_ids:
        return False
    
    for ev in evidence_records:
        # 2. claim_id в цели
        if ev.claim_id not in target_claim_ids:
            continue
        
        # 3. Привязка к паттерну
        if ev.linked_pattern_id != pattern.pattern_id:
            continue
        
        # 4. Версия
        if ev.object_version != pattern.version:
            continue
        
        # 5. Результат
        if ev.result != "PASSED":
            continue
        
        # 6. Метод
        if ev.method not in VALID_VERIFICATION_METHODS:
            continue
        
        # 7. Верификатор
        verifier = (ev.verifier or "").strip().lower()
        if verifier in _UNRELIABLE_VERIFIERS:
            continue
        
        return True
    
    return False
