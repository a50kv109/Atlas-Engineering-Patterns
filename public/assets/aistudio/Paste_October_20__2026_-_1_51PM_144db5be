"""
FIX 2: AUTHORIZATION — FAILED ≠ отсутствие проверки
Раздельная обработка FAILED, NOT_EXECUTED, INCONCLUSIVE, отсутствия.
"""

from typing import List, Set, Dict, Optional
from enum import Enum
from dataclasses import dataclass


class ApplicationAuthorization(str, Enum):
    AUTHORIZED = "AUTHORIZED"
    CONDITIONAL = "CONDITIONAL"
    DENIED = "DENIED"


class ConstraintSeverity(str, Enum):
    SAFETY = "SAFETY"
    FUNCTIONAL = "FUNCTIONAL"
    INFORMATIONAL = "INFORMATIONAL"


class EvidenceSeverity(str, Enum):
    CRITICAL = "CRITICAL"
    MAJOR = "MAJOR"
    MINOR = "MINOR"


class EvidenceResult(str, Enum):
    PASSED = "PASSED"
    FAILED = "FAILED"
    INCONCLUSIVE = "INCONCLUSIVE"
    NOT_EXECUTED = "NOT_EXECUTED"


class ConstraintVerdict(str, Enum):
    SATISFIED = "SATISFIED"
    VIOLATED = "VIOLATED"
    UNKNOWN = "UNKNOWN"
    NOT_APPLICABLE = "NOT_APPLICABLE"


# Матрица последствий для обязательных claim_id
# (severity, result) -> action
_MANDATORY_CONSEQUENCES = {
    # CRITICAL
    (EvidenceSeverity.CRITICAL, EvidenceResult.PASSED): "OK",
    (EvidenceSeverity.CRITICAL, EvidenceResult.FAILED): "DENIED",
    (EvidenceSeverity.CRITICAL, EvidenceResult.NOT_EXECUTED): "DENIED",
    (EvidenceSeverity.CRITICAL, EvidenceResult.INCONCLUSIVE): "DENIED",
    (EvidenceSeverity.CRITICAL, None): "DENIED",  # отсутствует
    # MAJOR
    (EvidenceSeverity.MAJOR, EvidenceResult.PASSED): "OK",
    (EvidenceSeverity.MAJOR, EvidenceResult.FAILED): "DENIED",
    (EvidenceSeverity.MAJOR, EvidenceResult.NOT_EXECUTED): "CONDITIONAL",
    (EvidenceSeverity.MAJOR, EvidenceResult.INCONCLUSIVE): "CONDITIONAL",
    (EvidenceSeverity.MAJOR, None): "CONDITIONAL",
    # MINOR
    (EvidenceSeverity.MINOR, EvidenceResult.PASSED): "OK",
    (EvidenceSeverity.MINOR, EvidenceResult.FAILED): "CONDITIONAL",
    (EvidenceSeverity.MINOR, EvidenceResult.NOT_EXECUTED): "CONDITIONAL",
    (EvidenceSeverity.MINOR, EvidenceResult.INCONCLUSIVE): "CONDITIONAL",
    (EvidenceSeverity.MINOR, None): "CONDITIONAL",
}

_ACTION_PRIORITY = {"DENIED": 2, "CONDITIONAL": 1, "OK": 0}


def compute_authorization(
    pattern,  # PatternRecord
    constraint_results: list,
    linked_evidence: list,
    strict_safety_mode: bool = True
) -> ApplicationAuthorization:
    """
    Вычисление авторизации с раздельной обработкой FAILED/NOT_EXECUTED/INCONCLUSIVE.
    
    Правила (по приоритету):
    1. Любой VIOLATED hard constraint (SAFETY/FUNCTIONAL) → DENIED
    2. SAFETY UNKNOWN → DENIED
    3. Обязательное свидетельство (из mandatory_claim_ids) → проверка по матрице
    4. FUNCTIONAL UNKNOWN в constraints → CONDITIONAL
    5. Иначе → AUTHORIZED
    """
    # === Шаг 1: Проверка прямых нарушений ===
    has_violation = any(
        cr.verdict == ConstraintVerdict.VIOLATED
        and cr.severity in {ConstraintSeverity.SAFETY, ConstraintSeverity.FUNCTIONAL}
        for cr in constraint_results
    )
    if has_violation:
        return ApplicationAuthorization.DENIED
    
    # === Шаг 2: SAFETY UNKNOWN ===
    has_safety_unknown = any(
        cr.verdict == ConstraintVerdict.UNKNOWN
        and cr.severity == ConstraintSeverity.SAFETY
        for cr in constraint_results
    )
    if has_safety_unknown:
        return ApplicationAuthorization.DENIED
    
    # === Шаг 3: Обязательные claim_id ===
    # Фильтрация свидетельств текущей версии
    current_version_evidence = [
        ev for ev in linked_evidence
        if ev.linked_pattern_id == pattern.pattern_id
        and ev.object_version == pattern.version
    ]
    
    # Словарь claim_id -> список свидетельств
    evidence_by_claim: Dict[str, List] = {}
    for ev in current_version_evidence:
        evidence_by_claim.setdefault(ev.claim_id, []).append(ev)
    
    # Обход mandatory_claim_ids
    worst_action = "OK"
    for m_claim_id in pattern.mandatory_claim_ids:
        evidence_list = evidence_by_claim.get(m_claim_id, [])
        
        if not evidence_list:
            # Отсутствует — определить severity по паттерну
            # (предполагаем CRITICAL по умолчанию для safety_mode)
            if strict_safety_mode:
                severity = EvidenceSeverity.CRITICAL
            else:
                severity = EvidenceSeverity.MAJOR
            action = _MANDATORY_CONSEQUENCES[(severity, None)]
        else:
            # Выбор канонического свидетельства (детерминированно)
            # НО: если есть FAILED — он имеет приоритет
            failed_evidence = [ev for ev in evidence_list if ev.result == EvidenceResult.FAILED]
            
            if failed_evidence:
                # FAILED не игнорируется даже при наличии PASSED
                canonical = max(failed_evidence, key=lambda e: (e.severity.value, e.evidence_id))
                action = _MANDATORY_CONSEQUENCES.get(
                    (canonical.severity, EvidenceResult.FAILED), "DENIED"
                )
            else:
                # Нет FAILED — выбираем по приоритету
                canonical = _select_canonical(evidence_list)
                action = _MANDATORY_CONSEQUENCES.get(
                    (canonical.severity, canonical.result), "CONDITIONAL"
                )
        
        # Аккумуляция худшего действия
        if _ACTION_PRIORITY[action] > _ACTION_PRIORITY[worst_action]:
            worst_action = action
        
        if worst_action == "DENIED":
            return ApplicationAuthorization.DENIED
    
    if worst_action == "CONDITIONAL":
        return ApplicationAuthorization.CONDITIONAL
    
    # === Шаг 4: FUNCTIONAL UNKNOWN в constraints ===
    has_functional_unknown = any(
        cr.verdict == ConstraintVerdict.UNKNOWN
        and cr.severity == ConstraintSeverity.FUNCTIONAL
        for cr in constraint_results
    )
    if has_functional_unknown:
        return ApplicationAuthorization.CONDITIONAL
    
    # === Шаг 5: AUTHORIZED ===
    return ApplicationAuthorization.AUTHORIZED


def _select_canonical(evidence_list: list):
    """Детерминированный выбор одного свидетельства (при отсутствии FAILED)"""
    priority = {
        EvidenceResult.PASSED: 0,
        EvidenceResult.INCONCLUSIVE: 1,
        EvidenceResult.NOT_EXECUTED: 2,
    }
    return min(evidence_list, key=lambda e: (
        priority.get(e.result, 3),
        -int(e.timestamp or "0"),
        e.evidence_id
    ))
```

